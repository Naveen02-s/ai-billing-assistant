generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  REFUND
  ADJUSTMENT
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String    @unique
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id])
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  sku         String        @unique
  description String?
  price       Decimal       @db.Decimal(12, 2)
  taxRate     Decimal       @default(18) @db.Decimal(5, 2)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  inventory   Inventory?
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Inventory {
  id             String   @id @default(cuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock          Int      @default(0)
  lowStockLevel  Int      @default(5)
  reservedStock  Int      @default(0)
  lastRestockedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String
  company   String?
  gstin     String?
  address   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  items           InvoiceItem[]
  payment         Payment?
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(PENDING)
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model Payment {
  id                 String        @id @default(cuid())
  invoiceId          String        @unique
  invoice            Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount             Decimal       @db.Decimal(12, 2)
  cashfreeOrderId    String?       @unique
  cashfreeCfOrderId  String?
  cashfreePaymentId  String?
  paymentSessionId   String?
  paymentMethod      String?
  paymentStatus      PaymentStatus @default(PENDING)
  qrPayload          String?
  qrImageDataUrl     String?
  webhookPayload     Json?
  paidAt             DateTime?
  transactions       Transaction[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Transaction {
  id                String          @id @default(cuid())
  paymentId         String
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type              TransactionType @default(PAYMENT)
  amount            Decimal         @db.Decimal(12, 2)
  gateway           String          @default("cashfree")
  gatewayEventId    String?         @unique
  cashfreePaymentId String?
  paymentMethod     String?
  status            PaymentStatus
  rawPayload        Json?
  createdAt         DateTime        @default(now())
}

model Analytics {
  id        String   @id @default(cuid())
  metric    String
  value     Decimal  @db.Decimal(14, 2)
  period    String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
